# Backend environment — copy to .env
APP_ENV=development
LOG_LEVEL=INFO

# Database (Supabase) — get these from Supabase Dashboard -> Connect
# Session-mode pooler (IPv4-compatible, port 5432) for runtime app queries:
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection string (port 5432) for Alembic migrations:
DATABASE_DIRECT_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres

# Redis & Background Queue (Upstash or local)
REDIS_URL=redis://127.0.0.1:6379/0

# Pacing & Inter-job Delays
INTER_JOB_DELAY_ENABLED=false
INTER_JOB_DELAY_MIN_MINUTES=5
INTER_JOB_DELAY_MAX_MINUTES=20

# AI Provider (deepseek or openai)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anti-bot & Captcha Solving
ZYTE_API_KEY=your-zyte-api-key
CAPSOLVER_API_KEY=your-capsolver-api-key

# Browser & Worker Automation
BROWSER_HEADLESS=true
WORKER_CONCURRENCY=2
NAV_TIMEOUT_MS=30000

# Network Outbound IP / Proxy (Playwright browser traffic, off by default)
PROXY_ENABLED=false
PROXY_URL=

# Artifact Storage (supabase, local, or s3)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<paste the service_role key from Supabase Settings -> API>
SUPABASE_STORAGE_BUCKET=artifacts

# S3 Storage (optional, used when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=job-agent-artifacts
S3_KEY=
S3_SECRET=
